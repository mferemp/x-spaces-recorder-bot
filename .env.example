# Required: obtain from @BotFather. Never commit your real token.
BOT_TOKEN=

# Required: your numeric Telegram account ID; the bot ignores everyone else.
ALLOWED_TELEGRAM_USER_ID=

# The resolver may need one of these because X changes its access controls.
# Keep secrets only in Railway/host environment variables.
X_BEARER_TOKEN=
X_GUEST_TOKEN=
X_COOKIE=

# Local working directory inside the container.
RECORDINGS_DIR=/app/recordings

# Conservative direct upload threshold. Long recordings usually require object storage.
MAX_TELEGRAM_UPLOAD_MB=45
