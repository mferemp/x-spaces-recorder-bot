BACKEND_PORT=3001
# Used only by telegram-bot.js. The API server starts without these.
# Set the token in the terminal. Do not commit it or paste it into chat.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_PUBLIC_BASE_URL=https://your-public-recorder-domain
# TELEGRAM_ALLOWED_USER_IDS=123456789
# Optional. When unset, the app generates a key and stores it in SQLite.
# X_CONN_ENC_KEY=
# Optional. Defaults to backend/data/app.db
# DATABASE_PATH=
